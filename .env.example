# Copy to .env.local and fill in. Most providers need NO env vars —
# API keys are pasted in the Settings UI (stored in browser localStorage).

# Prisma (only if you use the database features)
DATABASE_URL="file:./dev.db"

# NOTE: the default Z.ai provider (z-ai-web-dev-sdk) does NOT use env vars:
# it reads a `.z-ai-config` JSON file from the project root, $HOME, or /etc.
