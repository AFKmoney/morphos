{
  "$schema": "https://schema.tauri.app/config/2.0.0.json",
  "productName": "MorphOS",
  "version": "0.1.0",
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": true,
        "scope": [
          {
            "name": "Default",
            "allow": [
              "$EXE",
              "open",
              "**/node",
              "**/node.exe",
              "**/bun",
              "**/bun.exe"
            ]
          }
        ]
      },
      "fs": {
        "all": false,
        "readTextFile": true,
        "writeTextFile": true,
        "readBinaryFile": true,
        "writeBinaryFile": true,
        "readDir": true,
        "copyFile": true,
        "createDir": true,
        "removeDir": true,
        "removeFile": true,
        "renameFile": true
      },
      "path": {
        "all": true
      },
      "dialog": {
        "all": true
      },
      "notification": {
        "all": true
      },
      "os": {
        "all": false,
        "platform": true,
        "arch": true,
        "family": true,
        "version": true
      },
      "window": {
        "all": true
      },
      "process": {
        "all": false,
        "relaunch": true,
        "exit": true
      },
      "globalShortcut": {
        "all": true
      },
      "clipboard": {
        "all": true
      },
      "http": {
        "all": true,
        "scope": [
          {
            "name": "API",
            "allow": [
              "http://localhost:*",
              "https://localhost:*",
              "http://127.0.0.1:*",
              "https://127.0.0.1:*",
              "https://api.coingecko.com/*",
              "https://api.open-meteo.com/*",
              "https://cdn.jsdelivr.net/*",
              "https://raw.githubusercontent.com/*"
            ]
          }
        ]
      },
      "websocket": {
        "all": true,
        "scope": [
          {
            "name": "Local",
            "allow": [
              "ws://localhost:*",
              "wss://localhost:*",
              "ws://127.0.0.1:*",
              "wss://127.0.0.1:*"
            ]
          }
        ]
      },
      "updater": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.morphos.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBinaries": [],
      "macOS": {
        "entitlements": {
          "com.apple.security.app-sandbox": false,
          "com.apple.security.network.client": true,
          "com.apple.security.network.server": true,
          "com.apple.security.personal-information.ubiquity": true,
          "com.apple.security.files.user-selected.read-only": true,
          "com.apple.security.files.user-selected.read-write": true,
          "com.apple.security.files.bookmarks.app-scope": true
        },
        "hardenedRuntime": true,
        "gatekeeper": null,
        "notarization": null
      },
      "windows": [
        {
          "width": 1280,
          "height": 800,
          "minWidth": 800,
          "minHeight": 600,
          "maxWidth": 3840,
          "maxHeight": 2160,
          "resizable": true,
          "fullscreen": false,
          "title": "MorphOS",
          "visible": true,
          "decorations": true,
          "center": true,
          "transparent": false
        }
      ],
      "linux": {
        "category": "Development",
        "startupNotify": false
      }
    },
    "application": {
      "security": {
        "csp": null
      }
    }
  },
  "plugins": {
    "clipboard-manager": {
      "permissions": ["read", "write", "readText", "writeText", "readImage", "writeImage"]
    },
    "store": {
      "path": "morphos-store.json"
    },
    "websocket": {
      "allowAll": true
    },
    "positioner": {
      "modal": {
        "width": 600,
        "height": 400
      }
    }
  }
}
